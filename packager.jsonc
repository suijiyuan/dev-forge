{
  // VS Code Windows 发行包配置。
  "vscode": {
    // 必填。目标 VS Code 的完整稳定版本号，格式必须为 major.minor.patch。
    // 此版本既用于下载 VS Code，也用于筛选兼容的扩展版本。
    // 支持示例："1.95.3"、"1.100.0"。
    // 不支持："latest"、"1.95"、Insiders 版本或版本范围。
    "version": "1.133.0",

    // 可选，默认值："system"。Windows 发行包类型：
    // - "system"：System Installer，输出 .exe，通常用于整机安装；
    // - "user"：User Installer，输出 .exe，安装到当前用户目录；
    // - "archive"：免安装 ZIP；生成的 install.ps1 会自动解压它。
    "package": "user",

    // 可选，默认值："x64"。目标 Windows CPU 架构：
    // - "x64"：Intel/AMD 64 位 Windows；
    // - "arm64"：ARM 64 位 Windows。
    // 此项也用于优先选择同架构 VSIX；没有专用构建时选择通用 VSIX。
    "arch": "x64"
  },

  // 可选。扩展可以按 Default 和任意数量的 Profile 分组。
  // default 中的通用扩展会安装到 Default，并同步安装到每个已声明的 Profile。
  // profiles 中的扩展只安装到对应 Profile；Profile 不存在时由 VS Code 自动创建。
  // 每个扩展 ID 必须使用 "publisher.name" 格式。
  "extensions": {
    "default": [
      "davidanson.vscode-markdownlint",
      "eamodio.gitlens",
      "editorconfig.editorconfig",
      "esbenp.prettier-vscode",
      "formulahendry.auto-close-tag",
      "formulahendry.auto-complete-tag",
      "formulahendry.auto-rename-tag",
      "humao.rest-client",
      "ms-vscode-remote.remote-ssh",
      "ms-vscode-remote.remote-ssh-edit",
      "ms-vscode.remote-explorer",
      "redhat.vscode-xml",
      "redhat.vscode-yaml",
      "streetsidesoftware.code-spell-checker",
      "tyriar.sort-lines",
      "usernamehw.errorlens"
    ],
    "profiles": {
      "Profile 10 - Java": [
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "redhat.java",
        "vmware.vscode-boot-dev-pack",
        "vmware.vscode-spring-boot",
        "vscjava.vscode-gradle",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-dependency",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-java-test",
        "vscjava.vscode-lombok",
        "vscjava.vscode-maven",
        "vscjava.vscode-spring-boot-dashboard",
        "vscjava.vscode-spring-initializr",
        "yangbaopan.vscode-java-ibatisx"
      ],
      "Profile 20 - Python": [
        "charliermarsh.ruff",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "ms-vscode-remote.remote-containers"
      ],
      "Profile 30 - Database": [
        "xyz.plsql-language"
      ],
      "Profile 40 - Vue 2": [
        "christian-kohler.npm-intellisense",
        "christian-kohler.path-intellisense",
        "dbaeumer.vscode-eslint",
        "octref.vetur"
      ],
      "Profile 50 - Vue 3": [
        "christian-kohler.npm-intellisense",
        "christian-kohler.path-intellisense",
        "dbaeumer.vscode-eslint",
        "vue.volar"
      ]
    }
  },

  // 可选。default 是所有共享 Profile 使用的唯一配置文件：
  // - "auto"：从本机 VS Code Default Profile 抽取；不存在时生成空的 {}；
  // - 其他字符串：绝对路径、~ 路径，或相对于本配置文件的路径。
  // profiles 中的 use_default 表示该 Profile 直接共享 Default settings.json，
  // 不会在安装目标上复制第二份配置。
  "settings": {
    "default": "auto",
    "profiles": {
      "Profile 10 - Java": {
        "use_default": true
      },
      "Profile 20 - Python": {
        "use_default": true
      },
      "Profile 30 - Database": {
        "use_default": true
      },
      "Profile 40 - Vue 2": {
        "use_default": true
      },
      "Profile 50 - Vue 3": {
        "use_default": true
      }
    }
  },

  // 可选，默认值："dist"。产物输出目录。
  // 支持绝对路径、~ 路径，或相对于本配置文件的路径；不存在时自动创建。
  // 输出文件夹和 ZIP 名称由 VS Code 版本及架构自动生成。
  // 如果同名文件夹或 ZIP 已存在，程序会停止，避免覆盖已有产物。
  "output_dir": "dist"
}
